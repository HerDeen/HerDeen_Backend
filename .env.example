# Server Config
PORT=3000

# Database
DB_CONNECTION_URI=mongodb://localhost:27017/herdeen

# Admin Seed/Credentials
ADMIN_EMAIL=admin@herdeen.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_admin_password_here

# User Authentication Secrets
JWT_SECRET=your_user_jwt_access_secret_here
JWT_EXP=15m
JWT_REFRESH_TOKEN_SECRET=your_user_jwt_refresh_secret_here
JWT_REFRESH_TOKEN_EXP=7d

# Admin Authentication Secrets
ADMIN_JWT_SECRET=your_admin_jwt_access_secret_here
ADMIN_JWT_EXP=15m
ADMIN_JWT_REFRESH=your_admin_jwt_refresh_secret_here
ADMIN_JWT_REFRESH_EXP=7d

# Third-Party Integrations
RESEND_API_KEY=re_your_resend_api_key
RESEND_EMAIL=no-reply@yourdomain.com
PAYSTACK_SECRET_KEY=sk_test_your_paystack_key
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Security & Cryptography
ALGORITHM=aes-256-gcm
ENCRYPT_PASSWORD=your_encryption_passphrase_here
API_KEY=your_generic_api_key_here

# Redis (Optional/Recommended)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
